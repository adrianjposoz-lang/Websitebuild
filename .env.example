# Copy to .env.local for local work, or set in the hosting provider's environment settings.

# GoHighLevel inbound webhook URL for the /contact scenario form (Automation > Workflow >
# Inbound Webhook trigger). Server-only: never prefix it with NEXT_PUBLIC_. Must be https
# (http is accepted only for localhost mocks). Leave empty to keep the form in "does not
# deliver yet" mode, where nothing is sent.
GHL_WEBHOOK_URL=
